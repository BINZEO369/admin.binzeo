# Supabase project shared with auth.binzeo
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Public URL used for auth redirects
NEXT_PUBLIC_SITE_URL=https://admin.your-domain.com

# Marketing email SMTP remains server-side in auth.binzeo.
AUTH_APP_URL=https://auth-binzeo.vercel.app
