# Supabase project shared with auth.binzeo
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Public URL used for auth redirects
NEXT_PUBLIC_SITE_URL=https://admin.your-domain.com

# Server-only SMTP settings required for sending marketing emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-secret
